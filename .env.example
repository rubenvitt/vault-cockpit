# Öffentliche Adresse des Servers; die MCP-Resource ist <PUBLIC_URL>/mcp.
PUBLIC_URL=https://mcp.example.com

# Pocket ID ist der Authorization Server. Wir sind reiner Resource Server und
# stellen selbst keine Tokens aus — es braucht deshalb KEIN Client Secret.
OIDC_ISSUER=https://id.example.com

# Pflicht: Pocket-ID-Subjects mit Zugriff (Komma-Liste). Ohne Wert startet der
# Server nicht. Zusätzlich sollte der CIMD-Client in Pocket ID auf eine Gruppe
# beschränkt sein.
ALLOWED_SUBJECTS=

# --- Capture (optional) ---------------------------------------------------
# Token für POST /capture (iOS-Kurzbefehl, Sprachmemo) und /funke (Funke-App).
# Kann nur anlegen. Erzeugen z. B. mit: openssl rand -base64 32
CAPTURE_TOKEN=

# Zunder: `!` vorne leitet an die Zunder-Inbox weiter, #zunder an offenen
# Checkboxen ebenso (Zunder-Brücke). API-Token aus der Zunder-Web-UI (zt_…).
ZUNDER_URL=https://zunder.example.com
ZUNDER_TOKEN=
# ZUNDER_BRIDGE=off
# OBSIDIAN_VAULT_NAME=

# Mail: Fastmail-API-Token (nur Mail). Abgeholt wird aus MAIL_MAILBOX.
MAIL_JMAP_TOKEN=
MAIL_ALLOWED_SENDERS=
# MAIL_MAILBOX=Vault
# MAIL_DONE_MAILBOX=Archive
