# Öffentliche Adresse des Servers; die MCP-Resource ist <PUBLIC_URL>/mcp.
PUBLIC_URL=https://mcp.example.com

# Pocket ID ist der Authorization Server. Wir sind reiner Resource Server und
# stellen selbst keine Tokens aus — es braucht deshalb KEIN Client Secret.
OIDC_ISSUER=https://id.example.com

# Pflicht: Pocket-ID-Subjects mit Zugriff (Komma-Liste). Ohne Wert startet der
# Server nicht. Zusätzlich sollte der CIMD-Client in Pocket ID auf eine Gruppe
# beschränkt sein.
ALLOWED_SUBJECTS=

# --- Capture (optional) ---------------------------------------------------
# Token für POST /capture (iOS-Kurzbefehl, Sprachmemo) und /funke (Funke-App).
# Kann nur anlegen. Erzeugen z. B. mit: openssl rand -base64 32
CAPTURE_TOKEN=

# Zunder: `!` vorne leitet an die Zunder-Inbox weiter, #zunder an offenen
# Checkboxen ebenso (Zunder-Brücke). API-Token aus der Zunder-Web-UI (zt_…).
ZUNDER_URL=https://zunder.example.com
ZUNDER_TOKEN=
# ZUNDER_BRIDGE=off
# OBSIDIAN_VAULT_NAME=

# Mail: Fastmail-API-Token (nur Mail). Abgeholt wird aus MAIL_MAILBOX.
MAIL_JMAP_TOKEN=
MAIL_ALLOWED_SENDERS=
# MAIL_MAILBOX=Vault
# MAIL_DONE_MAILBOX=Archive

# --- Web-Cockpit (optional) -----------------------------------------------
# Wochenansicht unter <PUBLIC_URL>/. Eigener OIDC-Client in Pocket ID mit
# Callback <PUBLIC_URL>/auth/callback (öffentlicher Client mit PKCE genügt).
# Zugang haben dieselben ALLOWED_SUBJECTS wie bei MCP.
WEB_CLIENT_ID=
# WEB_CLIENT_SECRET=
# Signiert das Sitzungs-Cookie, mindestens 32 Zeichen: openssl rand -base64 48
SESSION_SECRET=
# COCKPIT_TZ=Europe/Berlin

# Termine per CalDAV, nur lesend. Fastmail: App-Passwort mit Zugriff
# „Kalender (CalDAV)“; URL ist das Kalender-Home des Kontos.
# CALDAV_URL=https://caldav.fastmail.com/dav/calendars/user/du@example.com/
# CALDAV_USERNAME=du@example.com
# CALDAV_PASSWORD=
# Nur diese Kalender (Anzeigenamen, Komma-Liste); leer = alle.
# CALDAV_CALENDARS=

# --- Semantische Suche und Graph (optional) ---------------------------------
# Embeddings über einen Ollama-Server (Dienst `ollama` in der Compose-Datei).
# Fehlt das Modell, lädt das Cockpit es beim ersten Lauf selbst.
# EMBED_URL=http://ollama:11434
# EMBED_MODEL=bge-m3
# VECTOR_DB=/data/vectors.db
