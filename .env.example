# Nur, was vor der ersten Anmeldung gebraucht wird. Alles andere (Zunder,
# Zunder-Brücke, Capture- und Such-Tokens, Mail, Embeddings, Kalender, Anzeige)
# stellt man im Web-Cockpit unter <PUBLIC_URL>/einstellungen ein; das
# Sitzungs-Secret erzeugt der Dienst selbst (beides unter /data).

# Öffentliche Adresse des Servers; die MCP-Resource ist <PUBLIC_URL>/mcp.
PUBLIC_URL=https://mcp.example.com

# Pocket ID ist der Authorization Server. Für MCP sind wir reiner Resource
# Server und stellen selbst keine Tokens aus.
OIDC_ISSUER=https://id.example.com

# Pflicht: Pocket-ID-Subjects mit Zugriff (Komma-Liste). Ohne Wert startet der
# Server nicht. Zusätzlich sollte der CIMD-Client in Pocket ID auf eine Gruppe
# beschränkt sein.
ALLOWED_SUBJECTS=

# Web-Cockpit: eigener OIDC-Client in Pocket ID mit Callback
# <PUBLIC_URL>/auth/callback. Zugang haben dieselben ALLOWED_SUBJECTS wie bei MCP.
WEB_CLIENT_ID=
WEB_CLIENT_SECRET=
