# Sidecar vault-sync (Obsidian Headless). Als sync.env neben den Stack legen.

# Anmeldung: entweder einmalig interaktiv ins Config-Volume
#   docker compose run --rm -it --entrypoint ob vault-sync login
# oder hier das Token setzen (etwa aus ~/.config/obsidian-headless/auth_token
# des bisherigen Host-Dienstes).
# OBSIDIAN_AUTH_TOKEN=

# Nur für die erste Einrichtung: exakter Name des Remote-Vaults
#   docker compose run --rm --entrypoint ob vault-sync sync-list-remote
VAULT_NAME=

# Nur bei Ende-zu-Ende-Verschlüsselung: das Vault-Passwort (nicht das Konto-Passwort).
# VAULT_PASSWORD=

# Optional, werden bei jedem Start per `ob sync-config` gesetzt:
# SYNC_MODE=bidirectional          # bidirectional | pull-only | mirror-remote
# CONFLICT_STRATEGY=merge          # merge | conflict
# EXCLUDED_FOLDERS=
# FILE_TYPES=image,pdf
# SYNC_CONFIGS=
